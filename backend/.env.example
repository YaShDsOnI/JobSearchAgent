APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///./data/jobfinderagent.db
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=60
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
ARTIFACT_STORAGE_PATH=./data/artifacts
ARTIFACT_ENCRYPTION_KEY=replace-with-url-safe-base64-for-32-bytes
MAX_UPLOAD_BYTES=5000000
LOG_LEVEL=INFO
SOURCE_NETWORK_ACCESS_ENABLED=false
SOURCE_EGRESS_ALLOWLIST=
# Required outside development/test when SOURCE_NETWORK_ACCESS_ENABLED=true.
SOURCE_EGRESS_PROXY_URL=
# Directory for file:<name> secret references (secret-manager projected files).
SECRETS_DIR=
# Health alert webhook: both or neither. The REF holds the URL (it usually embeds a token).
ALERT_WEBHOOK_REF=
ALERT_WEBHOOK_HOST=
# Backup CLI only (python -m app.backup): 32 bytes, URL-safe base64, different from
# ARTIFACT_ENCRYPTION_KEY. Do not give it to the API, worker, scheduler, or runner.
# BACKUP_ENCRYPTION_KEY=

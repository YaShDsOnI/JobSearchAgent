APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///./data/jobfinderagent.db
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=60
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
ARTIFACT_STORAGE_PATH=./data/artifacts
ARTIFACT_ENCRYPTION_KEY=replace-with-url-safe-base64-for-32-bytes
MAX_UPLOAD_BYTES=5000000
LOG_LEVEL=INFO
SOURCE_NETWORK_ACCESS_ENABLED=false
SOURCE_EGRESS_ALLOWLIST=
